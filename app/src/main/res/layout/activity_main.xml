<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Sharp, flat, 0dp rounded -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/title_sub"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mode Switch: 0dp corner, 0dp elevation -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleMediaType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:checkedButton="@id/btnTabPhoto"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabPhoto"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/tab_photo"
                android:textSize="13sp"
                app:cornerRadius="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTabVideo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="@string/tab_video"
                android:textSize="13sp"
                app:cornerRadius="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- PHOTO TARGET PLATFORM CARD: 0dp corner, 0dp elevation, no shadow -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhotoTargets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:text="TARGET FORMAT FOTO HD"
                    android:textColor="@color/primary_accent"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgPhotoTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/rbPhotoStory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:checked="true"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="WhatsApp Status &amp; IG Story (9:16 - 1080x1920)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbPhotoPortrait"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="Instagram Feed Portrait (4:5 - 1080x1350)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbPhotoSquare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="Instagram Feed Square (1:1 - 1080x1080)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbPhotoOriginal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="Format Asli HD (Rasio Asli - Max 2048px)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- VIDEO TARGET PLATFORM CARD: 0dp corner, 0dp elevation, no shadow -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVideoTargets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.08"
                    android:text="TARGET PLATFORM VIDEO HD"
                    android:textColor="@color/primary_accent"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/rgVideoTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <RadioButton
                        android:id="@+id/rbVideoInstagram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:checked="true"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="Instagram (Story &amp; Reels 1080p, 30fps, 8Mbps)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbVideoWhatsApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="WhatsApp Status HD (&lt;16MB Bypass Transcode)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/rbVideoTikTok"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/primary_accent"
                        android:fontFamily="sans-serif-medium"
                        android:padding="8dp"
                        android:text="TikTok HD (1080x1920, 12Mbps High Detail)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Media Picker & Preview Card: 0dp corner, 0dp elevation, no shadow -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="140dp"
                    android:layout_height="240dp"
                    android:background="@color/surface_card_secondary"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvMediaInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif"
                    android:text="@string/no_media_selected"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectMedia"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/select_photo"
                    android:textSize="13sp"
                    app:cornerRadius="0dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Advanced Tuning Card: 0dp corner, 0dp elevation, no shadow -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_subtle"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSharpen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/option_sharpen"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFpsLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:checked="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/option_fps"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Button: 0dp corner, 0dp elevation -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOptimize"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary_accent"
            android:elevation="0dp"
            app:elevation="0dp"
            android:enabled="false"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.04"
            android:text="@string/btn_optimize_photo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="0dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/status_ready"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Export Actions: 0dp corner, 0dp elevation -->
        <LinearLayout
            android:id="@+id/layoutExportActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShare"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="@color/success_green"
                android:elevation="0dp"
                app:elevation="0dp"
                android:fontFamily="sans-serif-bold"
                android:text="@string/btn_share"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:cornerRadius="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:elevation="0dp"
                app:elevation="0dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/btn_save"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:cornerRadius="0dp"
                app:strokeColor="@color/border_subtle" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
